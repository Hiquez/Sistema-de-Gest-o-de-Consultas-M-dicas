{
  "title": "Sistema de Gestão de Consultas Médicas",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total de Consultas por Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (consultas_status_total)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consultas ao longo do tempo (por status)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(consultas_status_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requisições HTTP por segundo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Uso de memória JVM (heap)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (area) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Status do Sistema de Fluxos (Health Check)",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "up{job=\"clinica-app\"}",
          "legendFormat": "clinica-app"
        }
      ]
    }
  ]
}